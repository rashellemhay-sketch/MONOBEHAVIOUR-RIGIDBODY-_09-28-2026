//GRID BASE MOVEMENT
//Attach this to a character GameObject. Good for roquelikes, puzzle games, tactics games. 
//The character snaps to whole tile positions rather than moving continuously. 

//Code proper
using UnityEngine;

public class GridMovement : MonoBehaviour
{
	public float tileSize= 1.0f; // size of one grid cell
	public float moveSpeed = 10f; //how fast your character glide between tiles (feel, not logic).

	private Vector3 targetPosition;
	private boos isMoving = false;

	void Start()
	{
	 //Snap Starting position to the grid so everthing lines up
		targetPosition = SnapToGrid(transform.position);
		transform.position= targetPosition;
	}
	void Update()
	{
	 if (!isMoving)
	 {
	  HandleInput();
	 }
	else
	{
	 // Smoothy glide to the next tile(this is presentation, not the actual logic)
	transform.position =Vector3.MoveTowards(transform.position, targetPosition, moveSpeed*Time.deltaTime);
	if(Vector3.Distance(transform.position, targetPosition)<0.001f)
	{
	 transform.position = targetPosition;
	 isMoving = false; 
	}
       }
    }
     void HandleInput()
     {
	Vector3 direction = Vecto.zero;

	if(Input.GetKeyDown(KeyDown.W)) direction = Vector3.up;
    else if(Input.GetKeyDown(KeyDown.S)) direction = Vector3.down;
    else if(Input.GetKeyDown(KeyDown.A)) direction = Vector3.left;
    else if(Input.GetKeyDown(KeyDown.D)) direction = Vector3.right;

        if(direction != Vector3.zero)
        {
           targetPosition = transform.position + direction*tileSize;
            isMoving = true;
        }
      }
    Vector3 SnapToGrid(Vector3 pos)
    { 
    return new Vector3(
        Mathf.Round(pos.x / tileSize)* tileSize,
        Mathf.Round(pos.y / tileSize)* tileSize,
        pos.z
        );
        }
}

//FREE (VECTOR BASED)MOVEMENT
// Attach this to a character GameObject. Good for top-down actions games, platformers
//(horizontal axis),twin-stick shooters.Movement is continuous, not tile locked.

using UnityEngine;

public class FreeMovement : MonoBehaviour
{
public float moveSpeed =5f;
    void update()
    {
        //GetAxis give smooth values between -1 and 1 (support keyboard and controller)
        float horizontal = Input.GetAxis("Horizontal"); //A/D or Left/Right Arrows
        float vertical = Input.GetAxis("Vertical"); //W/S or Up/Down Arrows

        Vector3 direction = new Vector3(horizontal, vertivcal 0f);

        //Normalize so diagonal movement isn't fater than straight movement
        if(direction.magnitude > 1f)
        {
            direction.Normalize(); 
        }
        transform.position +=direction *moveSpeed *Time.deltaTime;
    }
}

// PHYSIC BASED MOVEMENT 
//Attach this to the character GameObject that also has a Rigidbody2D component
// (Component > Physics 2D > Rigidbody 2D).Good for platformers with momentum, vehicles, anything that should feel like it has mass, gravity, and friction.

using UnityEngine;
            
[RequireComponent(typeof(Rigidbody 2D))]
public class PhysicsMovement : MonoBevahiour
{
    publicfloat moveForce = 10f;
    publicfloat jumpForce = 7f;
    publicfloat maxSpeed -= 6f;

    private RigidBody2D rb;
    private bool isGrounded = false;
    
    void Star()
    {
     rb = GetComponent<Rigidbody 2D>(); 
    }
     void Update()
     {
         //read input in Update (input should always be checked every frame)
         if(Input.GetKeyDown(KeyCode.Space) && isGroundend)
         {
              rb.AddForce(Vector2.up * jumpForce,ForceMode2D.Impluse);
         }
     }
    void FixedUpdate()
    {
        //Physic changes belong in FixedUpdate, which runs on a fixed timestep 
        //Independent of frame rate - this keep physics simulation stable.
        float horizontal = Input.GetAxis("Horizontl");
        rb.AddForce(new Vector(horizontal * moveForce, 0f));

        //Clamp horizontal speed so the character doesn't accelerate forever
        if(Mathf.Abs(rb.velovity.x)> maxSpeed)
        {
            rb.velocity = new Vector2(Mathf.Sign(rb.velosity.x)* maxSpeed, rb.velocity.y)
        }
    }
    void onCollisionEnter2D(Collision2D collision)
    {
       if(collision.gameObject.CompareTag("Ground"))
       {
            isGrounded = true;
       }
    }
     void onCollisionExit2D(Collision2D collision)
    {
       if(collision.gameObject.CompareTag("Ground"))
       {
            isGrounded = false;
       }
    }
}
